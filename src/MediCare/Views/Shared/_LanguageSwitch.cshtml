@* Language switch button: shows the other language and returns to the same page *@
@{
    var isAr = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
}
<a class="mc-lang-switch" href="/Culture/Set?culture=@(isAr ? "en-US" : "ar-EG")&returnUrl=@Uri.EscapeDataString(returnUrl)">
    <i data-lucide="globe" class="mc-icon-sm"></i>
    <span dir="auto">@(isAr ? "English" : "العربية")</span>
</a>
