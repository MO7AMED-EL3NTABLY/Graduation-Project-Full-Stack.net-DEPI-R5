@* Password strength meter + rules - the id must match data-strength on the input *@
@model string
<div id="@Model">
    <div class="mc-strength" data-level="0"><span></span><span></span><span></span><span></span></div>
    <div class="mc-strength-label" data-weak="@L["Weak password"]" data-strong="@L["Strong password"]"></div>
    <ul class="mc-rules">
        <li data-rule="length"><i data-lucide="check" class="mc-icon-sm"></i>@L["At least 8 characters"]</li>
        <li data-rule="case"><i data-lucide="check" class="mc-icon-sm"></i>@L["Upper & lower case letters"]</li>
        <li data-rule="number"><i data-lucide="check" class="mc-icon-sm"></i>@L["At least one number"]</li>
    </ul>
</div>
