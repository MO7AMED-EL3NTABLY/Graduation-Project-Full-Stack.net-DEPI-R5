@* الجزء المشترك من <head> بين الـ Layouts: الخطوط و Bootstrap (LTR أو RTL) والـ CSS *@
@{
    var isRtl = CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft;
}
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>@ViewData["Title"] - @L["MediCare"]</title>
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" />
@if (isRtl)
{
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.rtl.min.css" />
}
else
{
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
}
<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
