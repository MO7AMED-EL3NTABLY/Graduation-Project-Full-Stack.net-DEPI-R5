@model ResetPasswordViewModel
@{
    ViewData["Title"] = L["Set a new password"];
}
<span class="mc-auth__icon"><i data-lucide="lock" class="mc-icon"></i></span>
<h1 class="mc-auth__title">@L["Set a new password"]</h1>
<p class="mc-auth__subtitle">@L["Your new password must be different from the old one."]</p>

<form asp-action="ResetPassword" method="post" novalidate>
    <input type="hidden" asp-for="UserId" />
    <input type="hidden" asp-for="Token" />
    <div asp-validation-summary="ModelOnly" class="mc-alert mc-alert--danger"></div>

    <div class="mc-field mb-0">
        <label class="mc-label" asp-for="NewPassword">@L["New password"]</label>
        <input class="mc-input" asp-for="NewPassword" placeholder="••••••••" autocomplete="new-password" data-strength="pwd-strength" />
        <span asp-validation-for="NewPassword"></span>
    </div>
    <partial name="Accounts/_PasswordStrength" model='"pwd-strength"' />

    <div class="mc-field">
        <label class="mc-label" asp-for="ConfirmPassword">@L["Confirm new password"]</label>
        <input class="mc-input" asp-for="ConfirmPassword" placeholder="••••••••" autocomplete="new-password" />
        <span asp-validation-for="ConfirmPassword"></span>
    </div>

    <button type="submit" class="mc-btn mc-btn--primary mc-btn--block mc-btn--lg">@L["Reset password"]</button>
</form>
