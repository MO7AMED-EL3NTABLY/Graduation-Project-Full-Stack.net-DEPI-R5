@model RegisterPatientViewModel
@{
    ViewData["Title"] = L["Create patient account"];
}
<h1 class="mc-auth__title">@L["Create patient account"]</h1>
<p class="mc-auth__subtitle">@L["It only takes a minute."]</p>

<form asp-action="RegisterPatient" method="post" enctype="multipart/form-data" novalidate>
    <div asp-validation-summary="ModelOnly" class="mc-alert mc-alert--danger"></div>

    <div class="mc-photo">
        <span class="mc-photo__preview" id="photo-preview"><i data-lucide="image" class="mc-icon"></i></span>
        <span class="mc-photo__body">
            <span class="mc-photo__title d-block">@L["Profile photo"]</span>
            <span class="mc-photo__text d-block" id="photo-label">@L["Required · JPG or PNG"]</span>
            <span asp-validation-for="Photo"></span>
        </span>
        <label class="mc-btn mc-btn--soft mc-btn--sm mb-0">
            @L["Upload"]
            <input asp-for="Photo" type="file" class="mc-file-input" accept=".jpg,.jpeg,.png" data-file-label="photo-label" data-preview="photo-preview" />
        </label>
    </div>

    <div class="mc-field">
        <label class="mc-label" asp-for="FullName">@L["Full name"]</label>
        <input class="mc-input" asp-for="FullName" placeholder="@L["Enter your full name"]" autocomplete="name" />
        <span asp-validation-for="FullName"></span>
    </div>

    <div class="mc-row">
        <div class="mc-field">
            <label class="mc-label" asp-for="Email">@L["Email"]</label>
            <input class="mc-input" asp-for="Email" type="email" placeholder="name@example.com" autocomplete="email" />
            <span asp-validation-for="Email"></span>
        </div>
        <div class="mc-field">
            <label class="mc-label" asp-for="PhoneNumber">@L["Phone number"]</label>
            <input class="mc-input" asp-for="PhoneNumber" type="tel" placeholder="+20 1X XXX XXXX" autocomplete="tel" />
            <span asp-validation-for="PhoneNumber"></span>
        </div>
    </div>

    <div class="mc-row">
        <div class="mc-field">
            <label class="mc-label" asp-for="DateOfBirth">@L["Date of birth"]</label>
            <input class="mc-input" asp-for="DateOfBirth" type="date" asp-format="{0:yyyy-MM-dd}" max="@DateTime.Today.ToString("yyyy-MM-dd")" />
            <span asp-validation-for="DateOfBirth"></span>
        </div>
        <div class="mc-field">
            <span class="mc-label">@L["Gender"]</span>
            <div class="mc-segment mc-segment--block mc-segment--field">
                <span><input type="radio" asp-for="Gender" value="@Gender.Male" id="gender-male" /><label for="gender-male" class="w-100">@L["Male"]</label></span>
                <span><input type="radio" asp-for="Gender" value="@Gender.Female" id="gender-female" /><label for="gender-female" class="w-100">@L["Female"]</label></span>
            </div>
            <span asp-validation-for="Gender"></span>
        </div>
    </div>

    <div class="mc-row">
        <div class="mc-field">
            <label class="mc-label" asp-for="Password">@L["Password"]</label>
            <input class="mc-input" asp-for="Password" placeholder="••••••••" autocomplete="new-password" data-strength="pwd-strength" />
            <span asp-validation-for="Password"></span>
        </div>
        <div class="mc-field">
            <label class="mc-label" asp-for="ConfirmPassword">@L["Confirm password"]</label>
            <input class="mc-input" asp-for="ConfirmPassword" placeholder="••••••••" autocomplete="new-password" />
            <span asp-validation-for="ConfirmPassword"></span>
        </div>
    </div>
    <partial name="Accounts/_PasswordStrength" model='"pwd-strength"' />

    <div class="mc-field">
        <label class="mc-check"><input asp-for="AcceptTerms" /> @L["I agree to the Terms and Privacy Policy"]</label>
        <span asp-validation-for="AcceptTerms"></span>
    </div>

    <button type="submit" class="mc-btn mc-btn--primary mc-btn--block mc-btn--lg">@L["Create account"]</button>
</form>

<p class="mc-auth__footer">@L["Already have an account?"] <a class="mc-link" asp-action="Login">@L["Log in"]</a></p>
@*————*@
