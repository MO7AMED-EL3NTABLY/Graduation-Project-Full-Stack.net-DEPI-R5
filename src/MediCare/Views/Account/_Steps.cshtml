@* Doctor registration steps indicator - the JS updates the state *@
<div class="mc-steps" aria-hidden="true">
    <span class="mc-steps__item is-active" data-step-indicator><span class="mc-steps__dot">1</span>@L["Personal"]</span>
    <span class="mc-steps__line"></span>
    <span class="mc-steps__item" data-step-indicator><span class="mc-steps__dot">2</span>@L["Professional"]</span>
    <span class="mc-steps__line"></span>
    <span class="mc-steps__item" data-step-indicator><span class="mc-steps__dot">3</span>@L["Documents"]</span>
</div>
