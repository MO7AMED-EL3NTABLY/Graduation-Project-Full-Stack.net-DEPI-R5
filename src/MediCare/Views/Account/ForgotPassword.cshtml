@model ForgotPasswordViewModel
@{
    ViewData["Title"] = L["Forgot your password?"];
}
<span class="mc-auth__icon"><i data-lucide="lock" class="mc-icon"></i></span>
<h1 class="mc-auth__title">@L["Forgot your password?"]</h1>
<p class="mc-auth__subtitle">@L["Enter the email of your account."]</p>

<form asp-action="ForgotPassword" method="post" novalidate>
    <div asp-validation-summary="ModelOnly" class="mc-alert mc-alert--danger"></div>
    <div class="mc-field">
        <label class="mc-label" asp-for="Email">@L["Email"]</label>
        <input class="mc-input" asp-for="Email" type="email" placeholder="name@example.com" autocomplete="username" dir="ltr" />
        <span asp-validation-for="Email"></span>
    </div>
    <button type="submit" class="mc-btn mc-btn--primary mc-btn--block mc-btn--lg">@L["Continue"]</button>
</form>

<p class="mc-auth__footer"><a class="mc-link" asp-action="Login">@L["Back to log in"]</a></p>
