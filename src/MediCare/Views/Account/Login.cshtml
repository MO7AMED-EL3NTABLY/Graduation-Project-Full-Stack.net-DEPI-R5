@model LoginViewModel
@{
    ViewData["Title"] = L["Log in"];
}
<h1 class="mc-auth__title">@L["Welcome back"]</h1>
<p class="mc-auth__subtitle">@L["Log in to manage your appointments and prescriptions."]</p>

<form asp-action="Login" method="post" novalidate>
    <input type="hidden" asp-for="ReturnUrl" />
    <div asp-validation-summary="ModelOnly" class="mc-alert mc-alert--danger"></div>

    <div class="mc-field">
        <label class="mc-label" asp-for="Email">@L["Email"]</label>
        <input class="mc-input" asp-for="Email" type="email" placeholder="name@example.com" autocomplete="username" dir="ltr" />
        <span asp-validation-for="Email"></span>
    </div>

    <div class="mc-field">
        <label class="mc-label" asp-for="Password">@L["Password"]</label>
        <input class="mc-input" asp-for="Password" placeholder="••••••••" autocomplete="current-password" />
        <span asp-validation-for="Password"></span>
    </div>

    <div class="mc-auth__meta">
        <label class="mc-check"><input asp-for="RememberMe" /> @L["Remember me"]</label>
        <a class="mc-link" asp-action="ForgotPassword">@L["Forgot password?"]</a>
    </div>

    <button type="submit" class="mc-btn mc-btn--primary mc-btn--block mc-btn--lg">@L["Log in"]</button>

    <div class="mc-auth__note">
        <i data-lucide="shield-check" class="mc-icon-sm"></i>
        @L["5 failed attempts lock the account for 15 minutes."]
    </div>
</form>

<p class="mc-auth__footer">@L["New to MediCare?"] <a class="mc-link" asp-action="Register">@L["Create account"]</a></p>
@*————*@
